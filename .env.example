# FIRST DEPLOY NEEDS NONE OF THESE.
# The site builds and serves with zero environment variables.

NEXT_PUBLIC_SITE_URL=https://acellacademy.dpdns.org

# WebAuthn — Phase 9. DO NOT enrol passkeys until these are live on the
# real domain: credentials bind to RP_ID and cannot migrate.
WEBAUTHN_RP_ID=acellacademy.dpdns.org
WEBAUTHN_ORIGIN=https://acellacademy.dpdns.org
WEBAUTHN_RP_NAME=ACELL Academy

# Supabase — Phase 9
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Phase 9. Separate subdomains so a newsletter complaint spike
# cannot damage verification deliverability.
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=ACELL Academy <no-reply@acellacademy.dpdns.org>
BREVO_API_KEY=
EMAIL_FROM_MARKETING=ACELL Academy <news@news.acellacademy.dpdns.org>

# Secrets — Phase 9
BACKUP_CODE_PEPPER=
CAL_WEBHOOK_SECRET=

# Set true ONLY on Preview to see placeholder-copy warnings
NEXT_PUBLIC_SHOW_REVIEW_BANNERS=false
